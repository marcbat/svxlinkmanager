<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <UserSecretsId>aspnet-Spotnik.Gui-CD0BE138-429A-4FB1-865E-E55DA92114CE</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <DockerfileRunArguments>-v "C:\repos\svxlinkmanager\src\SvxlinkManager\SvxlinkConfig":/app/SvxlinkConfig</DockerfileRunArguments>
    <Company />
    <Authors>HB9GXP</Authors>
    <StartupObject></StartupObject>
