    </None>
    <None Update="SvxlinkConfig\Locale.tcl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="SvxlinkConfig\Logic.tcl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="svxlinkmanager.service">
